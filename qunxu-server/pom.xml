<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>qunxu-ai</artifactId>
        <groupId>tech.qunxu</groupId>
        <version>${revision}</version>
    </parent>
    <artifactId>qunxu-server</artifactId>
    <packaging>jar</packaging>
    <name>${project.artifactId}</name>
    <description>后端 Server 主项目，引入 qunxu-module-system 提供 RESTful API</description>

    <dependencies>
        <!-- 业务模块 -->
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-module-system</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-module-gateway</artifactId>
        </dependency>

        <!-- Web 相关：Web MVC、全局异常处理、访问日志过滤器 -->
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- API 文档：Swagger + Knife4j -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Spring Boot 打包插件（版本由根 pom 的 spring-boot BOM 锁定） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
