<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>qunxu-ai</artifactId>
        <groupId>tech.qunxu</groupId>
        <version>${revision}</version>
    </parent>
    <artifactId>qunxu-module-system</artifactId>
    <packaging>jar</packaging>
    <name>${project.artifactId}</name>
    <description>system 模块，支撑核心业务：用户、部门、角色、权限、菜单、多租户、字典等</description>

    <dependencies>
        <!-- 业务组件 -->
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-biz-data-permission</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 提供 Web MVC 注解（@RestController 等）与 Servlet API -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>tech.qunxu</groupId>
            <artifactId>qunxu-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
